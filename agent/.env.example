# Example only. The agent reads real environment variables, not this file.
# Never commit an actual agent token. Each agent gets its own credential.
FLEETLUMA_MODE=local
FLEETLUMA_AGENT_TOKEN=REPLACE_WITH_UNIQUE_SECRET
FLEETLUMA_COORDINATOR_URL=http://127.0.0.1:8000
FLEETLUMA_DISK_PATH=/

# Production cloud deployment: use FLEETLUMA_MODE=cloud and the real
# HTTPS Vercel API origin; token is privately provisioned in FastAPI/Postgres.
# FLEETLUMA_MODE=cloud
# FLEETLUMA_COORDINATOR_URL=https://your-secured-api.vercel.app

# Insecure lab LAN opt-in (never for cloud or university Wi-Fi):
# FLEETLUMA_ALLOW_INSECURE_LAN=true
