#!/bin/sh
set -eu
case "${1:-}" in
  remove|purge)
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
    fi
    ;;
esac
if [ "${1:-}" = purge ]; then
  rm -f /etc/fleetluma/agent.conf
  rmdir /etc/fleetluma 2>/dev/null || true
  # Explicit package purge removes the stored agent credential.
  rm -rf /var/lib/fleetluma
fi
exit 0
