#!/bin/sh
set -eu

case "${1:-}" in
  configure)
    if ! id fleetluma >/dev/null 2>&1; then
      adduser --system --group --home /var/lib/fleetluma --no-create-home fleetluma
    fi
    install -d -o fleetluma -g fleetluma -m 0700 /var/lib/fleetluma
    install -d -o root -g root -m 0755 /etc/fleetluma
    if [ ! -e /etc/fleetluma/agent.conf ]; then
      printf '%s\n' 'FLEETLUMA_COORDINATOR_URL=https://fleetluma-api.vercel.app' > /etc/fleetluma/agent.conf
      chmod 0644 /etc/fleetluma/agent.conf
    fi
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload
      systemctl enable fleetluma-agent.service
      systemctl restart fleetluma-agent.service
    fi
    ;;
esac
exit 0
