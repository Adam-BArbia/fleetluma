@startuml 12_activity_service
title Approved HTTP check - external FL-19 scheduled worker
start
:Supabase scheduled worker selects enabled service in workspace;
:Apply approved destination and SSRF protections;
if (Public endpoint allowed?) then (yes)
 :Start bounded HTTP GET with no redirects to private address;
 if (Response received?) then (yes)
  :Record HTTP status code and latency;
  if (Approved success status?) then (yes)
   :Persist HEALTHY result;
  else (no)
   :Persist UNHEALTHY result;
  endif
 else (no)
  :Persist UNHEALTHY timeout/network failure;
 endif
else (no)
 :Reject unsafe URL without network access;
endif
:Write check into private PostgreSQL;
stop
@enduml
