@startuml 10_object_snapshot
title Target workspace-scoped monitoring snapshot (synthetic)
object "workspace : Workspace" as ws {
 name = Personal Fleet
}
object "owner : WorkspaceMembership" as own {
 role = OWNER
}
object "hostA : Host" as a {
 name = TUFFEST
 lifecycle = ACTIVE
 status = CONNECTED
}
object "hostB : Host" as b {
 lifecycle = ACTIVE
 status = STALE
}
object "hostC : Host" as c {
 lifecycle = REVOKED
 status = REVOKED
}
object "website : MonitoredService" as w {
 enabled = true
 status = UNHEALTHY
}
object "sample : MetricSample" as s {
 cpuPct = 42
}
ws -- own
ws -- a
ws -- b
ws -- c
ws -- w
a -- s
note right of w : Service status independent of agent freshness.
note bottom of c : REVOKED supersedes heartbeat-derived state.
@enduml
