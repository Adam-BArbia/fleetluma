@startuml 29_composite_coordinator
title FastAPI Vercel cloud components - no in-process checker
rectangle "FastAPI cloud application (stateless across requests)" {
 component "Enrollment API" as Enrollment
 component "Workspace device management" as Admin
 component "Monitoring query API" as Query
 component "Agent report ingestion" as Ingest
 component "Operator JWT verification" as JWT
 component "Workspace membership authorization" as Member
 component "Active host token validator" as Token
 component "Host freshness and lifecycle policy" as Fresh
 component "PostgreSQL persistence" as Persist
}
database "Private Supabase PostgreSQL" as DB
component "Supabase Auth JWKS" as Auth
cloud "External Supabase Edge checker (FL-19)" as Checker
Enrollment --> Member
Admin --> Member
Query --> Member
Member --> JWT
JWT --> Auth
Ingest --> Token
Enrollment --> Persist
Admin --> Persist
Query --> Fresh
Query --> Persist
Ingest --> Persist
Persist --> DB : pooled TLS SQL
Checker --> DB : separate checks/retention
@enduml
