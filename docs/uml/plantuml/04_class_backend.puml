@startuml 04_class_backend
title FastAPI cloud domain services - target
interface HostRepository {
 +findWorkspaceHost(id, workspaceId): Host?
 +lookupActiveByTokenHash(digest): Host?
 +revoke(id, workspaceId)
 +updateHeartbeat(id, time)
}
interface MetricsRepository {
 +saveAtomic(report, hostId)
 +history(hostId, workspaceId, window)
}
interface PairingRepository {
 +createPending(request): PairingSession
 +resolveCodeHash(codeHash): PairingSession?
 +approveAtomic(sessionId, workspaceId, actorId): Host
 +pollByPrivateSecretHash(hash): PairingState
 +deny(sessionId)
}
interface MembershipRepository {
 +requireRole(actorId, workspaceId, roles)
}
interface AuditRepository {
 +recordRedacted(event)
}
class SupabaseJwtVerifier {
 +verifyIssuerAudienceExpiry(token): OperatorId
}
class OperatorAuthorization {
 +requireWorkspaceRole(jwt, workspaceId, allowedRoles)
}
class PairingService {
 +requestPairing(deviceInfo, tokenHash)
 +poll(privateCode)
 +approve(userCode, workspaceId, operator)
 +deny(pairingId, operator)
}
class AgentIngestionService {
 +accept(report, agentToken): AcceptedReport
}
class DeviceManagementService {
 +list(actor, workspaceId)
 +rename(actor, hostId, name)
 +revoke(actor, hostId)
}
class HostStatusPolicy {
 +state(lastSeenAt, lifecycle, now): HostState
}
class HistoryQueryService {
 +metrics(operator, hostId, window)
}
class ExternalHttpCheckWorker {
 +checkAllowlistedServices()
}
PairingService --> PairingRepository
PairingService --> OperatorAuthorization
PairingService --> AuditRepository
OperatorAuthorization --> SupabaseJwtVerifier
OperatorAuthorization --> MembershipRepository
AgentIngestionService --> HostRepository
AgentIngestionService --> MetricsRepository
DeviceManagementService --> HostRepository
DeviceManagementService --> OperatorAuthorization
DeviceManagementService --> AuditRepository
HistoryQueryService --> MetricsRepository
HistoryQueryService --> OperatorAuthorization
HistoryQueryService --> HostStatusPolicy
note right of ExternalHttpCheckWorker
 Separate Supabase scheduled function (FL-19).
 Never run as FastAPI background thread.
end note
@enduml
