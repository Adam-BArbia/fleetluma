@startuml 06_class_mobile
title Flutter Web and Android client - v0.1.0 target
class AuthGate {
 +signIn()
 +checkOperatorAuthorization()
 +signOut()
}
class FleetScreen {
 +renderWorkspaceHosts()
}
class HostDetailScreen {
 +renderMetricHistory()
}
class ProcessesScreen {
 +renderTopTen()
}
class ServicesScreen {
 +renderServiceChecks()
}
class AddDeviceScreen {
 +enterUserCode()
 +resolveSafeMetadata()
 +chooseWorkspace()
 +approveOrDeny()
}
class DeviceManagementScreen {
 +listDevices()
 +rename()
 +revoke()
}
class MonitoringApiClient {
 +getWorkspaceHosts()
 +getHistory(id)
 +getProcesses(id)
 +getServices()
}
class EnrollmentApiClient {
 +resolveCode(code)
 +approvePairing(id, workspaceId)
 +denyPairing(id)
 +getManagedHosts(workspaceId)
 +revokeHost(id)
}
class FleetViewModel {
 +refresh()
}
class DeviceViewModel {
 +requestApproval()
 +manageDevices()
}
AuthGate --> FleetScreen : only after approved JWT
FleetScreen --> FleetViewModel
HostDetailScreen --> MonitoringApiClient
ProcessesScreen --> MonitoringApiClient
ServicesScreen --> MonitoringApiClient
AddDeviceScreen --> DeviceViewModel
DeviceManagementScreen --> DeviceViewModel
DeviceViewModel --> EnrollmentApiClient
FleetViewModel --> MonitoringApiClient
note bottom
 Add-device UI is future implementation, not shipped.
 JWT user session alone is not workspace authorization.
end note
@enduml
