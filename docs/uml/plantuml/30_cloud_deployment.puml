@startuml 30_cloud_deployment
title FleetLuma - Proposed Cloud Deployment (design, not deployed)
skinparam componentStyle rectangle
node "Operators" {
  component "Flutter Web\nVercel Static" as Web
  component "Flutter Android" as Android
}
cloud "Vercel FleetLuma team" {
  component "FastAPI Python Functions\nHTTPS / REST" as API
}
node "Supabase FleetLuma" {
  database "PostgreSQL\nprivate fleetluma schema" as PG
  component "Supabase Auth\nJWT issuer" as Auth
  component "Scheduled HTTP checker\nEdge Function / Cron" as Scheduler
}
node "Real host A" {
  component "psutil Agent A" as AgentA
}
node "Real host B" {
  component "psutil Agent B" as AgentB
}
cloud "Allowlisted public\nHTTP endpoints" as Endpoints
Web --> API : HTTPS authenticated GET
Android --> API : HTTPS authenticated GET
AgentA --> API : HTTPS authenticated POST
AgentB --> API : HTTPS authenticated POST
API --> Auth : validate operator token
API --> PG : pooled TLS SQL
Scheduler --> Endpoints : bounded HTTP probe
Scheduler --> PG : checks and retention
note bottom of API
  No SQLite in cloud
  No in-process scheduled checker
  API contract remains 7 routes
end note
@enduml
